<%- include('./partials/header') %>

<section class="trains-hero">
  <h1>Train Schedules</h1>
  <p>
    Explore departure times, arrival times, and operating days across the Kizuna
    Rail network.
  </p>
</section>

<section class="trains-catalog">
  <div class="trains-state" id="schedules-loading">Loading schedules...</div>

  <div class="trains-state trains-error" id="schedules-error" hidden></div>

  <div class="trains-grid" id="schedules-list"></div>

  <template id="schedule-card-template">
    <article class="train-card schedule-card">
      <header class="train-card-header">
        <h2 data-field="trip"></h2>
        <span class="train-operator" data-field="status"></span>
      </header>

      <dl class="train-specs">
        <div class="spec-item">
          <dt>Departure</dt>
          <dd data-field="departure"></dd>
        </div>

        <div class="spec-item">
          <dt>Arrival</dt>
          <dd data-field="arrival"></dd>
        </div>
      </dl>

      <div class="schedule-days">
        <strong>Operating Days:</strong>
        <p data-field="days"></p>
      </div>
    </article>
  </template>
</section>

<%- include('./partials/footer') %>
