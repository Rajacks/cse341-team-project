<%- include('./partials/header') %>

<section class="trains-hero">
  <h1>Bookings Administration</h1>
  <p>View and filter passenger bookings dynamically hydrated via the API.</p>
</section>

<section class="trains-catalog">
  <!-- Filter Controls -->
  <form id="bookings-filter-form" class="bookings-filters" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; margin-bottom: 1.5rem;">
    <div>
      <label for="filter-ticket-class">Ticket Class</label>
      <select id="filter-ticket-class" name="ticketClass">
        <option value="">All Classes</option>
        <option value="standard">Standard Class</option>
        <option value="premium">Premium Class</option>
        <option value="first">First Class</option>
      </select>
    </div>

    <div>
      <label for="filter-start-date">Booked From</label>
      <input type="date" id="filter-start-date" name="startDate" />
    </div>

    <div>
      <label for="filter-end-date">Booked To</label>
      <input type="date" id="filter-end-date" name="endDate" />
    </div>

    <div>
      <button type="submit">Apply Filters</button>
      <button type="button" id="reset-filters-btn">Reset</button>
    </div>
  </form>

  <div class="trains-state" id="bookings-loading">Loading bookings...</div>
  <div class="trains-state trains-error" id="bookings-error" hidden></div>
  <div class="trains-state" id="bookings-empty" hidden>No bookings match the selected filters.</div>
  <div class="trains-grid" id="bookings-list"></div>

  <!-- Pagination Controls -->
  <nav class="pagination-controls" id="bookings-pagination" aria-label="Bookings pagination" hidden>
    <button type="button" id="prev-page-btn">Previous</button>
    <span id="page-info"></span>
    <button type="button" id="next-page-btn">Next</button>
  </nav>

  <!-- The Template block for Hydration -->
  <template id="booking-card-template">
    <article class="train-card schedule-card">
      <header class="train-card-header">
        <h2 data-field="name"></h2>
        <span class="train-operator" data-field="class"></span>
      </header>
      <dl class="train-specs">
        <div class="spec-item">
          <dt>Email</dt>
          <dd data-field="email"></dd>
        </div>
        <div class="spec-item">
          <dt>Tickets</dt>
          <dd data-field="tickets"></dd>
        </div>
      </dl>
      <div class="schedule-days">
        <strong>Date Booked:</strong>
        <p data-field="date"></p>
      </div>
    </article>
  </template>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterForm = document.getElementById('bookings-filter-form');
    const ticketClassSelect = document.getElementById('filter-ticket-class');
    const startDateInput = document.getElementById('filter-start-date');
    const endDateInput = document.getElementById('filter-end-date');
    const resetBtn = document.getElementById('reset-filters-btn');

    const loading = document.getElementById('bookings-loading');
    const errorElement = document.getElementById('bookings-error');
    const emptyElement = document.getElementById('bookings-empty');
    const list = document.getElementById('bookings-list');
    const template = document.getElementById('booking-card-template');
    const paginationNav = document.getElementById('bookings-pagination');
    const prevBtn = document.getElementById('prev-page-btn');
    const nextBtn = document.getElementById('next-page-btn');
    const pageInfo = document.getElementById('page-info');

    let currentPage = 1;
    const limit = 10;

    async function loadBookings(page) {
      loading.hidden = false;
      errorElement.hidden = true;
      emptyElement.hidden = true;
      paginationNav.hidden = true;
      list.replaceChildren();

      const params = new URLSearchParams({
        page: String(page),
        limit: String(limit),
      });

      if (ticketClassSelect.value) {
        params.set('ticketClass', ticketClassSelect.value);
      }
      if (startDateInput.value) {
        params.set('startDate', startDateInput.value);
      }
      if (endDateInput.value) {
        params.set('endDate', endDateInput.value);
      }

      try {
        const response = await fetch(`/api/bookings?${params.toString()}`);
        const result = await response.json();

        if (!response.ok) {
          const errorMessage =
            result.errors?.[0]?.message || result.message || 'Unable to load bookings.';
          throw new Error(errorMessage);
        }

        const { data: bookings, pagination } = result;
        currentPage = pagination.page;
        loading.hidden = true;

        if (!bookings.length) {
          emptyElement.hidden = false;
          return;
        }

        const fragment = document.createDocumentFragment();
        bookings.forEach((booking) => {
          const card = template.content.cloneNode(true);
          card.querySelector('[data-field="name"]').textContent = booking.passengerName;
          card.querySelector('[data-field="class"]').textContent = booking.ticketClass + ' Class';
          card.querySelector('[data-field="email"]').textContent = booking.passengerEmail;
          card.querySelector('[data-field="tickets"]').textContent = booking.numTickets;
          card.querySelector('[data-field="date"]').textContent = new Date(booking.dateBooked).toLocaleDateString();
          fragment.append(card);
        });

        list.replaceChildren(fragment);

        pageInfo.textContent = `Page ${pagination.page} of ${pagination.totalPages} (${pagination.totalItems} matching bookings)`;
        prevBtn.disabled = !pagination.hasPreviousPage;
        nextBtn.disabled = !pagination.hasNextPage;
        paginationNav.hidden = false;
      } catch (err) {
        loading.hidden = true;
        errorElement.hidden = false;
        errorElement.textContent = err.message;
      }
    }

    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      currentPage = 1;
      loadBookings(currentPage);
    });

    resetBtn.addEventListener('click', () => {
      filterForm.reset();
      currentPage = 1;
      loadBookings(currentPage);
    });

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        loadBookings(currentPage - 1);
      }
    });

    nextBtn.addEventListener('click', () => {
      loadBookings(currentPage + 1);
    });

    loadBookings(currentPage);
  });
</script>

<%- include('./partials/footer') %>