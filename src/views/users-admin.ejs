<%- include("partials/header", { title: "User Administration" }) %>

<div class="container">
  <h1>User Administration</h1>
  <p>Manage your profile details below. Administrators can manage all user accounts.</p>

  <p id="status-message" role="status" aria-live="polite"></p>

  <div id="users-list" aria-live="polite">
    <p>Loading users...</p>
  </div>

  <p><a href="/dashboard">User Dashboard</a> | <a href="/admin-dashboard">Admin Dashboard</a></p>
</div>

<script>
  const usersList = document.getElementById("users-list");
  const statusMessage = document.getElementById("status-message");

  const showMessage = (message) => {
    statusMessage.textContent = message;
  };

  const createField = (labelText, value, name) => {
    const label = document.createElement("label");
    label.textContent = labelText + " ";

    const input = document.createElement("input");
    input.type = "text";
    input.name = name;
    input.value = value ?? "";
    input.required = true;
    input.maxLength = 120;

    label.append(input);
    return { label, input };
  };

  const loadUsers = async () => {
    usersList.replaceChildren();
    const loading = document.createElement("p");
    loading.textContent = "Loading users...";
    usersList.append(loading);

    try {
      const response = await fetch("/api/users");

      if (!response.ok) {
        throw new Error("Unable to load users. Please sign in again if your session expired.");
      }

      const users = await response.json();
      usersList.replaceChildren();

      if (!users.length) {
        const empty = document.createElement("p");
        empty.textContent = "No users found.";
        usersList.append(empty);
        return;
      }

      users.forEach((user) => {
        const section = document.createElement("section");
        section.className = "user-card";

        const heading = document.createElement("h2");
        heading.textContent = user.displayName;
        section.append(heading);

        const role = document.createElement("p");
        role.textContent = "Role: " + user.role;
        section.append(role);

        const form = document.createElement("form");
        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          const updates = {
            displayName: displayName.input.value.trim(),
            username: username.input.value.trim(),
            email: email.input.value.trim(),
          };

          try {
            const updateResponse = await fetch("/api/users/" + encodeURIComponent(user.id), {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(updates),
            });

            const result = await updateResponse.json();

            if (!updateResponse.ok) {
              throw new Error(result.message || "Unable to update user.");
            }

            showMessage("User updated successfully.");
            await loadUsers();
          } catch (error) {
            showMessage(error.message);
          }
        });

        const displayName = createField("Display name:", user.displayName, "displayName");
        const username = createField("Username:", user.username, "username");
        const email = createField("Email:", user.email, "email");
        email.input.type = "email";

        form.append(displayName.label, document.createElement("br"));
        form.append(username.label, document.createElement("br"));
        form.append(email.label, document.createElement("br"));

        const saveButton = document.createElement("button");
        saveButton.type = "submit";
        saveButton.textContent = "Save Changes";
        form.append(saveButton);
        section.append(form);

        const deleteButton = document.createElement("button");
        deleteButton.type = "button";
        deleteButton.textContent = "Delete User";
        deleteButton.addEventListener("click", async () => {
          if (!window.confirm("Are you sure you want to delete this account?")) {
            return;
          }

          try {
            const deleteResponse = await fetch("/api/users/" + encodeURIComponent(user.id), {
              method: "DELETE",
            });

            const result = await deleteResponse.json();

            if (!deleteResponse.ok) {
              throw new Error(result.message || "Unable to delete user.");
            }

            if (result.signedOut) {
              window.location.assign("/login");
              return;
            }

            showMessage("User deleted successfully.");
            await loadUsers();
          } catch (error) {
            showMessage(error.message);
          }
        });

        section.append(deleteButton);
        usersList.append(section);
      });
    } catch (error) {
      usersList.replaceChildren();
      const message = document.createElement("p");
      message.textContent = error.message;
      usersList.append(message);
    }
  };

  loadUsers();
</script>

<%- include("partials/footer") %>
